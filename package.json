{
  "name": "astroguide",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --port=2499 --host=127.0.0.1",
    "dev:lan": "vite --port=2499 --host=0.0.0.0",
    "dev:demo": "vite --mode demo --port=2499 --host=127.0.0.1",
    "demo:capture": "node scripts/capture-demo.mjs",
    "dev:demo:lan": "vite --mode demo --port=2499 --host=0.0.0.0",
    "build": "npm run typecheck && vite build",
    "build:demo": "npm run typecheck && vite build --mode demo",
    "preview": "vite preview --host=127.0.0.1",
    "preview:lan": "vite preview --host=0.0.0.0",
    "preview:demo": "vite preview --host=127.0.0.1",
    "preview:demo:lan": "vite preview --host=0.0.0.0",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:version": "node scripts/check-version.mjs",
    "check": "npm run check:version && npm run lint && npm run typecheck && npm run test && npm run build && npm run build:demo"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@vitest/mocker": "4.1.11",
    "js-yaml": "4.3.2"
  }
}
